<?xml version="1.0" encoding="utf-8"?>
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:mp="http://schemas.microsoft.com/appx/2014/phone/manifest"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  IgnorableNamespaces="uap mp">
  <Identity
    Name="${XBOX_D3D12_PACKAGE_NAME}"
    Publisher="${XBOX_D3D12_PACKAGE_PUBLISHER}"
    Version="${XBOX_D3D12_PACKAGE_VERSION}" />
  <mp:PhoneIdentity PhoneProductId="${XBOX_D3D12_PHONE_PRODUCT_ID}" PhonePublisherId="00000000-0000-0000-0000-000000000000" />
  <Properties>
    <DisplayName>xbox-series-d3d12 probes</DisplayName>
    <PublisherDisplayName>${XBOX_D3D12_PUBLISHER_DISPLAY_NAME}</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
    <uap:SupportedUsers>multiple</uap:SupportedUsers>
  </Properties>
  <Dependencies>
    <TargetDeviceFamily Name="Windows.Xbox" MinVersion="10.0.19041.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>
  <Resources>
    <Resource Language="x-generate" />
  </Resources>
  <Applications>
    <Application Id="App" Executable="$targetnametoken$.exe" EntryPoint="xbox_series_d3d12.App">
      <uap:VisualElements
        DisplayName="xbox-series-d3d12 probes"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png"
        Description="Phase 0 feasibility probes"
        BackgroundColor="transparent">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png" />
        <uap:SplashScreen Image="Assets\SplashScreen.png" />
      </uap:VisualElements>
    </Application>
  </Applications>
  <Capabilities>
    <Capability Name="codeGeneration" />
  </Capabilities>
</Package>
